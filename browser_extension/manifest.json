{
    "manifest_version": 3,
    "name": "De Best Password Manager",
    "version":"1.0",
    "description": "Helps you save passwords from browser login forms",
    "content_scripts":[
        {
            "matches":["<all_urls>"],
            "js": ["content.js"],
            "run_at":"document_idle"
        }
    ],
    "background" : {
        "service_worker":"background.js"},
    "host_permissions": ["http://127.0.0.1:5000/*"]

}